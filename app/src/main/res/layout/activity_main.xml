<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/studio_bg">

    <LinearLayout
        android:id="@+id/mainVerticalLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Barra Superior Nativa para Tablet (adaptable a vertical y horizontal) -->
        <LinearLayout
            android:id="@+id/nativeTopBar"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:background="@color/studio_surface"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <View
                android:id="@+id/statusDot"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:background="#10B981" />

            <TextView
                android:id="@+id/tvStudioTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="VIDEO STUDIO"
                android:textColor="@color/studio_text"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvEngineBadge"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="ARM64 Nativo"
                android:textColor="@color/studio_accent"
                android:textSize="10sp" />

            <Button
                android:id="@+id/btnNativeImport"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingStart="7dp"
                android:paddingTop="2dp"
                android:paddingEnd="7dp"
                android:paddingBottom="2dp"
                android:text="+ Galería"
                android:textAllCaps="false"
                android:textColor="@color/studio_emerald"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnExportsFolder"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingStart="7dp"
                android:paddingTop="2dp"
                android:paddingEnd="7dp"
                android:paddingBottom="2dp"
                android:text="Exportados"
                android:textAllCaps="false"
                android:textColor="@color/studio_text"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnFullscreen"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingStart="7dp"
                android:paddingTop="2dp"
                android:paddingEnd="7dp"
                android:paddingBottom="2dp"
                android:text="Cine"
                android:textAllCaps="false"
                android:textColor="@color/studio_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <View
            android:id="@+id/topBarDivider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/studio_border" />

        <!-- Contenedor dinámico para WebView (permite recreación segura si el renderer crashea) -->
        <FrameLayout
            android:id="@+id/webViewHost"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/studio_bg">

            <WebView
                android:id="@+id/studioWebView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/studio_bg" />
        </FrameLayout>

    </LinearLayout>

    <!-- Botón flotante discreto para restaurar barra superior cuando está en Pantalla Completa -->
    <Button
        android:id="@+id/btnRestoreBar"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="wrap_content"
        android:layout_height="30dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="110dp"
        android:alpha="0.85"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minHeight="0dp"
        android:paddingStart="8dp"
        android:paddingTop="0dp"
        android:paddingEnd="8dp"
        android:paddingBottom="0dp"
        android:text="Barra"
        android:textAllCaps="false"
        android:textSize="10sp"
        android:visibility="gone" />

    <!-- Splash de carga inicial mientras inicia el servidor embebido -->
    <LinearLayout
        android:id="@+id/loadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/studio_bg"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <ProgressBar
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:indeterminateTint="@color/studio_accent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Iniciando Tablet Video Studio..."
            android:textColor="@color/studio_text"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvLoadingSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Preparando motor multipista Hardware ARM64 y biblioteca multimedia"
            android:textColor="@color/studio_muted"
            android:textSize="13sp" />
    </LinearLayout>

</FrameLayout>
